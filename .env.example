# Copy to .env and fill in. Vite inlines these into the bundle at BUILD time,
# so .env must exist on the machine that runs `npm run build` — putting it on
# the server does nothing. Rebuild after any change here.
#
# Nothing in this file is a secret: every VITE_* value is compiled into the
# JavaScript that ships to the browser. Anyone can read them in devtools.
# Protect the EmailJS account with domain allowlisting in the EmailJS
# dashboard, not by hiding these values.

# EmailJS — contact form. From dashboard.emailjs.com
# Email Services -> Service ID
VITE_SERVICE_ID=your_service_id
# Email Templates -> Template ID
VITE_TEMPLATE_ID=your_template_id
# Account -> General -> Public Key
VITE_PUBLIC_KEY=your_public_key

# Chat backend origin. No trailing slash — the app appends /api/health and
# /api/chat. Must be https:// in production or the browser blocks it as mixed
# content. This origin has to send CORS headers allowing https://abduboriy.me
VITE_BACKEND_URL=https://llm.abduboriy.me
